<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow a plain-http dev server (for example http://192.168.x.x:8700). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
