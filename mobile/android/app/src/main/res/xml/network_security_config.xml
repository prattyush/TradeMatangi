<?xml version="1.0" encoding="utf-8"?>
<!-- Release: https only, system certificate authorities only. A debug build overrides this file
     (src/debug/res/xml) so a developer can reach a plain-http server on the LAN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
